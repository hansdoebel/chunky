+            return nil
+        }
+        switch grpc.config.params.vectorsConfig.config {
+        case .params(let params):
+            return params.size
+        case .paramsMap(let map):
+            if let dense = map.map["dense"] {
+                return dense.size
+            }
+            return map.map.count == 1 ? map.map.values.first?.size : nil
+        case nil:
+            return nil
+        }
+    }
+}
